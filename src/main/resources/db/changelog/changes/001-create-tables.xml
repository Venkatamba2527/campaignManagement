<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--1. CHANNEL table-->

    <changeSet id="001-create-channel" author="campaign-platform">
        <createTable tableName="channel">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="channel" indexName="idx_channel_type">
            <column name="type"/>
        </createIndex>
    </changeSet>

    <!--2. CAMPAIGN table-->

    <changeSet id="002-create-campaign" author="campaign-platform">
        <createTable tableName="campaign">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(30)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="budget" type="NUMERIC(15,2)"/>
            <column name="currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="start_at" type="TIMESTAMPTZ"/>
            <column name="end_at" type="TIMESTAMPTZ"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="campaign" indexName="idx_campaign_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="campaign" indexName="idx_campaign_dates">
            <column name="start_at"/>
            <column name="end_at"/>
        </createIndex>
    </changeSet>

    <!--  3. CAMPAIGN_CHANNEL (many-to-many) -->

    <changeSet id="003-create-campaign-channel" author="campaign-platform">
        <createTable tableName="campaign_channel">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="campaign_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="channel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allocation_percent" type="NUMERIC(5,2)"/>
            <column name="budget_allocated" type="NUMERIC(15,2)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="campaign_channel"
                baseColumnNames="campaign_id"
                referencedTableName="campaign"
                referencedColumnNames="id"
                constraintName="fk_campaign_channel_campaign"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="campaign_channel"
                baseColumnNames="channel_id"
                referencedTableName="channel"
                referencedColumnNames="id"
                constraintName="fk_campaign_channel_channel"
                onDelete="RESTRICT"/>

        <addUniqueConstraint
                tableName="campaign_channel"
                columnNames="campaign_id, channel_id"
                constraintName="uk_campaign_channel"/>
    </changeSet>

    <!-- 4. CAMPAIGN_METRIC (daily performance)-->
    <changeSet id="004-create-campaign-metric" author="campaign-platform">
        <createTable tableName="campaign_metric">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="campaign_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="metric_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="impressions" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="clicks" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="conversions" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="spend" type="NUMERIC(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="revenue" type="NUMERIC(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="campaign_metric"
                baseColumnNames="campaign_id"
                referencedTableName="campaign"
                referencedColumnNames="id"
                constraintName="fk_campaign_metric_campaign"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="campaign_metric"
                columnNames="campaign_id, metric_date"
                constraintName="uk_campaign_metric_date"/>

        <createIndex tableName="campaign_metric" indexName="idx_campaign_metric_date">
            <column name="metric_date"/>
        </createIndex>
    </changeSet>

    <!--5. CAMPAIGN_STATUS_HISTORY (audit)-->
    <changeSet id="005-create-status-history" author="campaign-platform">
        <createTable tableName="campaign_status_history">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="campaign_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="old_status" type="VARCHAR(30)"/>
            <column name="new_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="VARCHAR(100)"/>
            <column name="changed_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="campaign_status_history"
                baseColumnNames="campaign_id"
                referencedTableName="campaign"
                referencedColumnNames="id"
                constraintName="fk_status_history_campaign"
                onDelete="CASCADE"/>

        <createIndex tableName="campaign_status_history" indexName="idx_status_history_campaign">
            <column name="campaign_id"/>
        </createIndex>
    </changeSet>

    <!-- 6. Seed some default channels-->
    <changeSet id="006-seed-channels" author="campaign-platform">
        <insert tableName="channel">
            <column name="name" value="Email"/>
            <column name="type" value="EMAIL"/>
            <column name="description" value="Email marketing campaigns"/>
        </insert>
        <insert tableName="channel">
            <column name="name" value="SMS"/>
            <column name="type" value="SMS"/>
            <column name="description" value="SMS / text message campaigns"/>
        </insert>
        <insert tableName="channel">
            <column name="name" value="Social Media"/>
            <column name="type" value="SOCIAL"/>
            <column name="description" value="Facebook, Instagram, LinkedIn, X, etc."/>
        </insert>
        <insert tableName="channel">
            <column name="name" value="Push Notification"/>
            <column name="type" value="PUSH"/>
            <column name="description" value="Mobile and web push notifications"/>
        </insert>
        <insert tableName="channel">
            <column name="name" value="Display Ads"/>
            <column name="type" value="DISPLAY"/>
            <column name="description" value="Banner and display advertising"/>
        </insert>
    </changeSet>

</databaseChangeLog>