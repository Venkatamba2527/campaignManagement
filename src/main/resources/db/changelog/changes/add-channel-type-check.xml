<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="db.changelog-20260930000008-add-channel-type-check" author="campaign-platform">

        <comment>
            Add CHECK constraint to enforce valid channel type values
        </comment>

        <sql dbms="postgresql" splitStatements="true" stripComments="true">
            <![CDATA[
            ALTER TABLE public.channel
                ADD CONSTRAINT chk_channel_type
                CHECK (type IN ('EMAIL', 'SMS', 'SOCIAL', 'PUSH', 'DISPLAY'));
            ]]>
        </sql>

        <rollback>
            <sql dbms="postgresql" splitStatements="true" stripComments="true">
                <![CDATA[
                ALTER TABLE public.channel
                    DROP CONSTRAINT IF EXISTS chk_channel_type;
                ]]>
            </sql>
        </rollback>

    </changeSet>

</databaseChangeLog>
